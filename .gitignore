# ===== 金鑰（絕對不能上傳）=====
.env
.env.*
!.env.example

# ===== 虛擬環境 =====
.venv/
venv/
env/

# ===== Python 自動產生的檔案 =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ===== 執行紀錄 =====
# collect.log 要上傳（GitHub Actions 會 commit 它，tools/check_data.py 用它估算 TDX 點數）；
# 其他 .log 不上傳
logs/*.log
!logs/collect.log

# ===== 編輯器 / 系統 =====
.vscode/
.idea/
.DS_Store
Thumbs.db

# 注意：data/ 與 results/ 刻意「不」忽略，要一起上傳讓組員共用
